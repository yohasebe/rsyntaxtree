#!/usr/bin/env ruby
# frozen_string_literal: true

require 'optimist'
require 'yaml'
require 'json'

require_relative '../lib/rsyntaxtree'
require_relative '../lib/rsyntaxtree/utils'
require_relative '../lib/rsyntaxtree/format_converter'

# Valid configuration keys and their validators
CONFIG_VALIDATORS = {
  outdir: ->(v) { FileTest.directory?(v) ? nil : "must be an existing directory path" },
  outfilename: ->(v) { v.is_a?(String) ? nil : "must be a string" },
  format: ->(v) { /\A(png|jpg|gif|pdf|svg|lsif|tikz)\z/ =~ v.to_s ? nil : "must be png, jpg, gif, pdf, svg, lsif, or tikz" },
  leafstyle: ->(v) { /\A(auto|triangle|bar|nothing)\z/ =~ v.to_s ? nil : "must be auto, triangle, bar, or nothing" },
  fontstyle: ->(v) { /\A(sans|serif|cjk|mono)\z/ =~ v.to_s ? nil : "must be sans, serif, cjk, or mono" },
  fontsize: ->(v) { v.is_a?(Integer) && v >= 8 && v <= 26 ? nil : "must be in the range of 8-26" },
  linewidth: ->(v) { v.is_a?(Integer) && v >= 1 && v <= 5 ? nil : "must be in the range of 1-5" },
  vheight: ->(v) { v.is_a?(Numeric) && v >= 0.5 && v <= 5.0 ? nil : "must be in the range of 0.5-5.0" },
  color: ->(v) { /\A(modern|traditional|gray|grey|on|off|true|false)\z/ =~ v.to_s ? nil : "must be modern, traditional, gray, or off" },
  symmetrize: ->(v) { /\A(on|off|true|false)\z/ =~ v.to_s ? nil : "must be on or off" },
  transparent: ->(v) { /\A(on|off|true|false)\z/ =~ v.to_s ? nil : "must be on or off" },
  polyline: ->(v) { /\A(on|off|true|false)\z/ =~ v.to_s ? nil : "must be on or off" },
  hide_default_connectors: ->(v) { /\A(on|off|true|false)\z/ =~ v.to_s ? nil : "must be on or off" },
  mirror: ->(v) { /\A(on|off|true|false)\z/ =~ v.to_s ? nil : "must be on or off" },
  tidy: ->(v) { /\A(off|symmetric|low|medium|high|on|compact|true|false)\z/ =~ v.to_s ? nil : "must be off, symmetric, low, medium, or high" },
  hspacing: ->(v) { v.is_a?(Numeric) && v >= 0.5 && v <= 3.0 ? nil : "must be in the range of 0.5-3.0" },
  tidy_spacing: ->(v) { v.is_a?(Numeric) && v >= 0.5 && v <= 3.0 ? nil : "must be in the range of 0.5-3.0" },
  direction: ->(v) { /\A(ttb|ltr)\z/ =~ v.to_s ? nil : "must be ttb or ltr" },
  hyphen: ->(v) { /\A(markup|literal)\z/ =~ v.to_s ? nil : "must be markup or literal" }
}.freeze

# Validate configuration and return errors/warnings
def validate_config(config, source_path)
  errors = []
  warnings = []

  config.each do |key, value|
    key_sym = key.to_sym
    if CONFIG_VALIDATORS.key?(key_sym)
      error_msg = CONFIG_VALIDATORS[key_sym].call(value)
      if error_msg
        errors << "Error in #{source_path}: '#{key}' #{error_msg} (got: #{value.inspect})"
      end
    else
      warnings << "Warning: unknown option '#{key}' in #{source_path}"
    end
  end

  { errors: errors, warnings: warnings }
end

# Load configuration from .rsyntaxtreerc files
def load_config
  config = {}
  all_errors = []
  all_warnings = []

  config_files = [
    File.join(Dir.home, '.rsyntaxtreerc'),
    File.join(Dir.pwd, '.rsyntaxtreerc')
  ]

  config_files.each do |path|
    if File.exist?(path)
      file_config = YAML.safe_load(File.read(path), symbolize_names: true) || {}
      validation = validate_config(file_config, path)
      all_errors.concat(validation[:errors])
      all_warnings.concat(validation[:warnings])
      config.merge!(file_config)
    end
  end

  { config: config, errors: all_errors, warnings: all_warnings }
end

loaded = load_config
file_config = loaded[:config]

# Show warnings for unknown keys
loaded[:warnings].each { |w| warn w }

# Exit with errors for invalid values
unless loaded[:errors].empty?
  loaded[:errors].each { |e| warn e }
  exit 1
end

opts = Optimist.options do
  version "RSyntaxTree #{RSyntaxTree::VERSION} (c) 2026 Yoichiro Hasebe"
  banner <<~BANNER
    RSyntaxTree, (linguistic) syntax tree generator written in Ruby.

    Usage:
           1) rsyntaxtree [options] "[S [NP text] [VP here]]"
           2) rsyntaxtree [options] "(S (NP text) (VP here))"  # Penn TreeBank format
           3) rsyntaxtree [options] "/path/to/text/file"
           4) echo "[S [NP text] [VP here]]" | rsyntaxtree [options]
    where [options] are:
  BANNER

  opt :outdir, "Output directory", default: "./", short: :o
  opt :outfilename, "Output file base name", default: "syntree", short: :u
  opt :format, "Output format: png, jpg, gif, pdf, svg, lsif, or tikz", default: "png", short: :f
  opt :leafstyle, "visual style of tree leaves: auto, triangle, bar, or nothing", default: "auto", short: :l
  opt :fontstyle, "Font style: sans, serif, cjk, mono", default: "sans", short: :n
  opt :fontsize, "Size: 8-26", default: 16, short: :s
  opt :linewidth, "Size: 1-5", default: 1, short: :i
  opt :vheight, "Connector Height: 0.5-5.0", default: 2.0, short: :v
  opt :color, "Color text and bars: modern, traditional, gray, or off", default: "modern", short: :c
  opt :symmetrize, "DEPRECATED alias of --tidy symmetric: on or off", default: "off", short: :y
  opt :transparent, "Make background transparent: on or off", default: "off", short: :r
  opt :polyline, "draw polyline connectors: on or off", default: "off", short: :p
  opt :hide_default_connectors, "make default connectors transparent: on or off", default: "off", short: :none
  opt :mirror, "flip the tree horizontally (RTL linguistics convention: first word at the right edge): on or off", default: "off"
  opt :tidy, "tidy tree layout: off, symmetric (radical symmetrization), low (packed, strict leaf positions), medium (packed; leaves may overlap but never swap order), or high (packed; leaf order kept per row only)", default: "off", short: :none
  opt :hspacing, "Horizontal spacing factor (counterpart of vheight): 0.5-3.0", default: 1.0, short: :none
  opt :tidy_spacing, "DEPRECATED alias of --hspacing: 0.5-3.0", default: 1.0, short: :none
  opt :direction, "Tree layout direction: ttb (top-to-bottom) or ltr (left-to-right)", default: "ttb", short: :d
  opt :hyphen, "How a hyphen in a label reads: markup (-underline-) or literal (a hyphen; \-underline\- then underlines)", default: "markup", short: :none
  opt :validate, "Validate the input without drawing or writing a file: print a machine-readable diagnosis (JSON) to stdout and report the result in the exit code", short: :none
  opt :notation, "Print the notation reference to stdout and exit", short: :none
  opt :help, "This is a custom help message", short: :h
end

Optimist.die :outdir, "must be an exsting directory path" unless FileTest.directory?(opts[:outdir])
Optimist.die :direction, "must be ttb or ltr" unless /\A(ttb|ltr)\z/ =~ opts[:direction]
Optimist.die :hyphen, "must be markup or literal" unless /\A(markup|literal)\z/ =~ opts[:hyphen]
Optimist.die :format, "must be png, jpg, gif, pdf, svg, lsif, or tikz" unless /\A(png|jpg|gif|pdf|svg|lsif|tikz)\z/ =~ opts[:format]
Optimist.die :leafstyle, "must be auto, triangle, bar, or nothing" unless /\A(auto|triangle|bar|nothing)\z/ =~ opts[:leafstyle]
Optimist.die :fontstyle, "must be sans, serif, cjk, or mono" unless /\A(sans|serif|cjk|mono)\z/ =~ opts[:fontstyle]
Optimist.die :fontsize, "must be in the range of 8-26" unless opts[:fontsize] >= 8 && opts[:fontsize] <= 26
Optimist.die :linewidth, "must be in the range of 1-5" unless opts[:linewidth] >= 1 && opts[:linewidth] <= 5
Optimist.die :color, "must be either modern, traditional, gray, or off" unless /\A(modern|traditional|gray|grey|on|off|true|false)\z/ =~ opts[:color]
Optimist.die :symmetrize, "must be either on or off" unless /\A(on|off|true|false)\z/ =~ opts[:symmetrize]
Optimist.die :vheight, "must be in the range of 0.5-5.0" if opts[:vheight] < 0.5 || opts[:vheight] > 5.0
Optimist.die :transparent, "must be either on or off" unless /\A(on|off|true|false)\z/ =~ opts[:transparent]
Optimist.die :polyline, "must be either on or off" unless /\A(on|off|true|false)\z/ =~ opts[:polyline]
Optimist.die :hide_default_connectors, "must be either on or off" unless /\A(on|off|true|false)\z/ =~ opts[:hide_default_connectors]
Optimist.die :mirror, "must be either on or off" unless /\A(on|off|true|false)\z/ =~ opts[:mirror]
Optimist.die :tidy, "must be off, symmetric, low, medium, or high" unless /\A(off|symmetric|low|medium|high|on|compact|true|false)\z/ =~ opts[:tidy]
Optimist.die :hspacing, "must be in the range of 0.5-3.0" if opts[:hspacing] < 0.5 || opts[:hspacing] > 3.0
Optimist.die :tidy_spacing, "must be in the range of 0.5-3.0" if opts[:tidy_spacing] < 0.5 || opts[:tidy_spacing] > 3.0

# Merge config file options with CLI options (CLI takes precedence)
string_opts = {}

# First, apply config file defaults
file_config.each do |key, value|
  string_opts[key.to_sym] = value
end

# Then, apply CLI options (overrides config file)
opts.each do |key, value|
  key_sym = key.to_sym
  # Skip internal optimist keys
  next if key.to_s.start_with?('_')
  # Only override if explicitly given on CLI or not in config
  if opts[:"#{key}_given"] || !file_config.key?(key_sym)
    string_opts[key_sym] = value
  end
end

if %w[jpg gif].include?(string_opts[:format])
  warn "Warning: #{string_opts[:format].upcase} output is deprecated and will be removed in RSyntaxTree 2.0. Use PNG instead."
end

# An argument names a file only if it really is one: File.exist? on an
# expanded empty string answers for the current directory, and reading that
# as the tree ended the run with a Ruby error.
data = if ARGV[0] && !ARGV[0].empty? && File.file?(File.expand_path(ARGV[0]))
         File.read ARGV[0]
       elsif ARGV[0]
         ARGV[0]
       elsif !$stdin.tty?
         $stdin.read
       else
         nil
       end

# Auto-convert Penn TreeBank format to bracket notation
data = RSyntaxTree::FormatConverter.to_bracket(data) if data

if opts[:notation]
  puts File.read(File.expand_path("../lib/rsyntaxtree/notation_core.md", __dir__))
  exit 0
end

# Validate without drawing or writing anything: the diagnosis goes to stdout
# as JSON and the exit code carries the verdict.
if opts[:validate]
  diagnosis = begin
    RSyntaxTree::RSGenerator.check_data(data, string_opts)
    { "schema" => "rsyntaxtree.error/1", "ok" => true }
  rescue RSTError => e
    { "schema" => "rsyntaxtree.error/1" }.merge(e.to_h)
  end
  puts JSON.pretty_generate(diagnosis)
  exit(diagnosis["ok"] ? 0 : 1)
end

begin
  RSyntaxTree::RSGenerator.check_data(data, string_opts)
rescue RSTError => e
  warn e
  exit 1
end

begin
  string_opts[:data] = data
  rsg = RSyntaxTree::RSGenerator.new(string_opts)
  ext = string_opts[:format]
  outfilename = string_opts[:outfilename] || "syntree"
  file_ext = case ext
             when "lsif" then "lsif.json"
             when "tikz" then "tex" # forest code, to be included in a LaTeX document
             else ext
             end
  filepath = File.expand_path(string_opts[:outdir]) + "/#{outfilename}.#{file_ext}"
  draw_method = "draw_#{ext}"
  output = rsg.send(draw_method)
  File.binwrite(filepath, output)
rescue RSTError => e
  warn e
  exit 1
rescue StandardError => e
  warn "Error: something unexpected occurred"
  warn "#{e.class}: #{e.message}"
  exit 1
end
