# frozen_string_literal: true

source "https://rubygems.org"

# GitHub Pages builds this site with its own toolchain; this Gemfile is for
# previewing it locally. The github-pages gem pins Liquid 4.0.3, which calls
# String#tainted? and so cannot run on Ruby 3.2 or later, which is why a
# local preview used to be impossible. Jekyll 4 with the remote theme
# renders the same pages.
gem "jekyll", "~> 4.3"
gem "jekyll-remote-theme"
gem "jekyll-feed", "~> 0.12"
gem "jekyll-seo-tag"
gem "webrick"

# Standard library gems Ruby no longer bundles by default.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
